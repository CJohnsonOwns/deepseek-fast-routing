+    std::atomic<int64_t> ca_picks{0}, ca_cold{0};   // (the serve lane) CPU-lane picks, of them not warm
+    std::unique_ptr<std::atomic<int>[]> ca_prev;    // (the serve lane writes) layers x kPicks: the last word's picks
+    void cache_route_ctl() {   // (between requests) DS4_CACHE_ROUTE_CTL
+        static const char* path = std::getenv("DS4_CACHE_ROUTE_CTL");
+        if (path == nullptr || *path == 0) return;
+        std::FILE* f = std::fopen(path, "r");
+        if (f == nullptr) return;
+        float b = 0, v = 0, s = 0;
+        const int n = std::fscanf(f, "%f %f %f", &b, &v, &s);
+        std::fclose(f);
+        if (n != 3 || !std::isfinite(b) || !std::isfinite(v) || !std::isfinite(s) || b < 0 || v < 0 || s < 0 || b > 1 || v > 1 || s > 1) return;
+        if (b == ca_bonus && v == ca_vram && s == ca_sticky) return;
+        ca_bonus = b, ca_vram = v, ca_sticky = s;
+        std::fprintf(stderr, "ds4: cache route set: +%.3f warm, +%.3f VRAM, +%.3f sticky\n", b, v, s);
+    }
+    bool ca_warm_now(const Layer& l, int e) const {
+        if (l.slot[(size_t) e] >= 0) return true;
+        if (!l.ram.empty() && l.ram[(size_t) e] >= 0) return true;
+        return store && store->find(l.il, e) >= 0;
