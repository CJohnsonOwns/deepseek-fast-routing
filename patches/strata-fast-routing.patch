+    float ca_sticky = env_f("DS4_CACHE_ROUTE_STICKY", 0.0f);
+    const int ca_every = std::max(1, (int) env_f("DS4_CACHE_ROUTE_EVERY", 4.0f));
+    const int ca_from = std::max(0, (int) env_f("DS4_CACHE_ROUTE_FROM", 0.0f));
+    const bool ca_log = env_f("DS4_CACHE_ROUTE_LOG", 0.0f) != 0.0f;
+    bool ca_any() const { return ca_bonus > 0.0f || ca_vram > 0.0f || ca_sticky > 0.0f; }
+    std::vector<std::vector<float>> ca_base;     // per layer: its bias without the bonus (the model's own + any mix)
+    std::vector<std::vector<float>> ca_sent;     // per layer: the bias the device has now (empty: the base)
+    float* ca_pin[2] = {nullptr, nullptr};       // pinned upload buffers (layers x 1024), used in turn
+    int ca_buf = 0;
