+    bool ca_upload(Layer& l, const float* b) {
+        for (size_t m = 0; m <= l.mates.size(); ++m) {   // (each group member keeps its own copy)
+            Layer& lm = member(l, (int) m);
+            if (lm.gate_bias == nullptr || lm.dev < 0 || (size_t) lm.dev >= devs.size()) continue;
+            Dev& d = devs[(size_t) lm.dev];
+            cudaSetDevice(d.id);
+            const cudaError_t e = cudaMemcpyAsync(lm.gate_bias, b, (size_t) l.n_exp * 4, cudaMemcpyHostToDevice, d.st);
+            if (e != cudaSuccess) {
+                std::fprintf(stderr, "ds4: cache route: %s (off)\n", cudaGetErrorString(e));
+                return false;
+            }
+        }
+        return true;
+    }
+    void cache_route_restore() {   // the biases without the bonus (before a prompt, before a mix is made)
+        if (!ca_on) return;
+        int dev0 = 0;
+        (void) cudaGetDevice(&dev0);
+        for (size_t li = 0; li < L.size() && li < ca_base.size(); ++li)
