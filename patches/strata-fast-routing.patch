+                    return;
+                }
+            std::fprintf(stderr, "ds4: cache route on: +%.3f warm, +%.3f VRAM, +%.3f sticky, every %d tokens, layers from %d\n",
+                         ca_bonus, ca_vram, ca_sticky, ca_every, ca_from);
+        }
+        if (ca_base.empty()) {   // (read back once, and again after a mix changed them)
+            ca_base.assign(L.size(), {});
+            ca_sent.assign(L.size(), {});
+            for (size_t li = 0; li < L.size(); ++li) {
+                const Layer& l = L[li];
+                if (l.mtp || l.gate_bias == nullptr || l.dev < 0 || (size_t) l.dev >= devs.size() || l.n_exp > 1024) continue;
+                cudaSetDevice(devs[(size_t) l.dev].id);
+                ca_base[li].resize((size_t) l.n_exp);
+                if (cudaMemcpy(ca_base[li].data(), l.gate_bias, (size_t) l.n_exp * 4, cudaMemcpyDeviceToHost) != cudaSuccess)
+                    ca_base[li].clear();
+            }
