+            ca_sent[li].assign(b, b + l.n_exp);
+            ++ca_uploads;
+        }
+        cudaSetDevice(dev0);
+        if (!ok) {
+            ca_on = true;
+            cache_route_restore();
+            ca_bonus = ca_vram = ca_sticky = 0.0f;
+            return;
+        }
+        ca_on = true;
+    }
