+    void cache_route_apply() {   // (the decode path, between tokens)
+        if (!ca_any() || ca_prompt > 0) return;
+        if (ca_on && ca_sticky <= 0.0f && (ca_tick++ % (uint64_t) ca_every) != 0) return;
+        int dev0 = 0;
+        (void) cudaGetDevice(&dev0);
+        if (ca_pin[0] == nullptr) {
